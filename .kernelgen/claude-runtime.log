287	                    & (numerator_h % stride_h == 0)
288	                    & (numerator_w % stride_w == 0)
289	                )
290	                h_out = numerator_h // stride_h
291	                w_out = numerator_w // stride_w
292	                out_bounds_mask = (
293	                    (h_out >= 0) & (h_out < out_h) & (w_out >= 0) & (w_out < out_w)
294	                )
295	                load_mask = valid_map_mask & out_bounds_mask
296
297	                safe_h_out = tl.where(load_mask, h_out, 0)
298	                safe_w_out = tl.where(load_mask, w_out, 0)
299	                safe_d_out = tl.where(load_mask, d_out, 0)
300	                out_offsets = (
301	                    safe_d_out * out_stride_d + safe_h_out * out_stride_h + safe_w_out
302	                )
303
304	                indices_block = tl.load(
305	                    indices_base_ptr + out_offsets, mask=load_mask, other=-1
306	                )
307	                match_mask = indices_block == current_input_flat_idx
308
309	                grad_block = tl.load(
310	                    grad_output_base_ptr + out_offsets,
311	                    mask=match_mask,
312	                    other=0.0,
313	                )
314	                grad_acc += grad_block
315
316	    in_spatial = in_h * in_w
317	    grad_input_base_ptr = grad_input_ptr + nc_idx * in_d * in_spatial
318	    grad_input_offsets = (
319	        d_in_idx * in_spatial + h_in_offsets[:, None] * in_w + w_in_offsets[None, :]
320	    )
321	    store_mask = (h_in_offsets[:, None] < in_h) & (w_in_offsets[None, :] < in_w)
322	    tl.store(grad_input_base_ptr + grad_input_offsets, grad_acc, mask=store_mask)
