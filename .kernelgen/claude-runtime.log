121	    pid_dhw = tl.program_id(1)
122
123	    num_h_blocks = tl.cdiv(out_h, BLOCK_H)
124	    num_w_blocks = tl.cdiv(out_w, BLOCK_W)
125
126	    d_block_idx = pid_dhw // (num_h_blocks * num_w_blocks)
127	    hw_remainder = pid_dhw % (num_h_blocks * num_w_blocks)
128	    h_block_idx = hw_remainder // num_w_blocks
129	    w_block_idx = hw_remainder % num_w_blocks
