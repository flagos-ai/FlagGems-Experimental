143
144	    input_base_ptr = input_ptr + n_idx * in_stride_n + c_idx * in_stride_c
145
146	    for kd in tl.static_range(0, kernel_d):
147	        d_in = d_out * stride_d - padding_d + kd * dilation_d
148	        d_valid = (d_in >= 0) & (d_in < in_d)
149	        for kh in tl.static_range(0, kernel_h):
150	            for kw in tl.static_range(0, kernel_w):
