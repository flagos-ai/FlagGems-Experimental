99	        # set mask
100	        mask = m_offset[:, None] < M and n_offset[None, :] < N
101	        inp_ptrs = inp + offset
102	        inp_vals = tl.load(inp_ptrs, mask=mask, other=min_value)
103	        if dtype is tl.int64:
