118	def max(inp):
119	    logger.debug("GEMS_ASCEND MAX")
120	    inp = inp.contiguous()
121	    M = inp.numel()
122	    block_size = triton.next_power_of_2(math.ceil(math.sqrt(M)))
123	    mid_size = triton.cdiv(M, block_size)
124	    block_mid = triton.next_power_of_2(mid_size)
125
126	    dtype = inp.dtype
127	    mid = torch.empty((mid_size,), dtype=dtype, device=inp.device)
128	    out = torch.empty([], dtype=dtype, device=inp.device)
129
130	    with torch_device_fn.device(inp.device):
131	        max_kernel_1[(mid_size, 1, 1)](inp, mid, M, block_size)
132	        max_kernel_2[(1, 1, 1)](mid, out, mid_size, block_mid)
133	    return out
