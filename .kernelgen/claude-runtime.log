136	def max_dim(inp, dim=None, keepdim=False):
137	    logger.debug("GEMS_ASCEND MAX")
138	    assert dim >= -inp.ndim and dim < inp.ndim, "Invalid dim"
139	    shape = inp.shape
140	    dim = dim % inp.ndim
141	    N = shape[dim]
142	    M = math.prod(shape[:dim])
143	    K = inp.numel() // M // N
144
145	    inp = inp.contiguous()
146
147	    shape_list = list(shape)
148	    shape_list[dim] = 1
149	    out_value = torch.empty(shape_list, dtype=inp.dtype, device=inp.device)
150	    out_index = torch.empty(shape_list, dtype=torch.int64, device=inp.device)
151
152	    if not keepdim:
153	        out_value = torch.squeeze(out_value, dim)
154	        out_index = torch.squeeze(out_index, dim)
155
156	    def grid(meta):
157	        axis0 = triton.cdiv(M, meta["BLOCK_M"])
158	        axis1 = K
