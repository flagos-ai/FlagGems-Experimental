27	def pool3d_output_size(
28	    in_size: int,
29	    kernel_size: int,
30	    stride: int,
31	    padding: int,
32	    dilation: int,
33	    ceil_mode: bool = False,
34	) -> int:
35	    """Compute one spatial dimension of the 3-D max-pool output."""
36	    effective_kernel_size = (kernel_size - 1) * dilation + 1
37	    numerator = in_size + 2 * padding - effective_kernel_size
38	    if ceil_mode:
39	        output_size = (numerator + stride - 1) // stride + 1
40	        # PyTorch-compatible adjustment for ceil_mode
41	        if (output_size - 1) * stride >= in_size + padding:
42	            output_size -= 1
43	    else:
44	        output_size = numerator // stride + 1
45	    return output_size
