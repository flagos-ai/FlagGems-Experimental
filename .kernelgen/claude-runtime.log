245	    stride_h, stride_w = _parse_param(stride, "stride", default=(kernel_h, kernel_w))
246	    padding_h, padding_w = _parse_param(padding, "padding", default=(0, 0))
247	    dilation_h, dilation_w = _parse_param(dilation, "dilation", default=(1, 1))
248
