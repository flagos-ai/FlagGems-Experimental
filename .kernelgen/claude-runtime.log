            import torch

def run(x, kernel_size, stride, padding, dilation, ceil_mode):
    out, indices = torch.nn.functional.max_pool3d(x, kernel_size=kernel_size, stride=stride, padding=padding, dilation=dilation, ceil_mode=ceil_mode, return_indices=True)
    return (out, indices)

def valid(ref_outputs, sol_outputs, inputs, ctx):
    out_ref = ref_outputs[0]
    out_sol = sol_outputs[0]
    indices_sol = sol_outputs[1]
    x = inputs[0]
    if not torch.allclose(out_ref, out_sol):
        return {'passed': False, 'message': 'Output values mismatch', 'metrics': {}}
    N, C, D, H, W = x.shape
    spatial_size = D * H * W
    x_flat_spatial = x.reshape(N, C, spatial_size)
    b_idx = torch.arange(N, device=x.device).view(N, 1, 1, 1, 1)
    c_idx = torch.arange(C, device=x.device).view(1, C, 1, 1, 1)
    gathered = x_flat_spatial[b_idx, c_idx, indices_sol]
    if not torch.allclose(gathered, out_sol):
        return {'passed': False, 'message': 'Indices do not gather to correct output values', 'metrics': {}}
    return {'passed': True, 'message': 'OK', 'metrics': {}}

