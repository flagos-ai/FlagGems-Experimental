157	def max_pool2d_backward_kernel(
158	    grad_output_ptr,
159	    indices_ptr,
160	    grad_input_ptr,
161	    # Shape info
162	    in_h,
163	    in_w,
164	    out_h,
165	    out_w,
166	    # Strides for grad_output/indices
167	    out_stride_nc,
168	    out_stride_h,
169	    out_stride_w,
170	    # Pooling parameters
171	    kernel_h: tl.constexpr,
172	    kernel_w: tl.constexpr,
173	    stride_h: tl.constexpr,
174	    stride_w: tl.constexpr,
175	    padding_h: tl.constexpr,
176	    padding_w: tl.constexpr,
177	    dilation_h: tl.constexpr,
178	    dilation_w: tl.constexpr,
179	    # Tiling parameters
180	    BLOCK_IN_H: tl.constexpr,
181	    BLOCK_IN_W: tl.constexpr,
182	):
183	    nc_idx = tl.program_id(0)
184	    pid_hw = tl.program_id(1)
185
186	    num_w_blocks = tl.cdiv(in_w, BLOCK_IN_W)
187	    h_block_idx = pid_hw // num_w_blocks
188	    w_block_idx = pid_hw % num_w_blocks
189
190	    h_in_offsets = h_block_idx * BLOCK_IN_H + tl.arange(0, BLOCK_IN_H)
191	    w_in_offsets = w_block_idx * BLOCK_IN_W + tl.arange(0, BLOCK_IN_W)
192
193	    current_input_flat_idx = h_in_offsets[:, None] * in_w + w_in_offsets[None, :]
194	    grad_acc = tl.zeros((BLOCK_IN_H, BLOCK_IN_W), dtype=tl.float32)
195
196	    indices_base_ptr = indices_ptr + nc_idx * out_stride_nc
197	    grad_output_base_ptr = grad_output_ptr + nc_idx * out_stride_nc
198
199	    for kh in tl.static_range(0, kernel_h):
200	        for kw in tl.static_range(0, kernel_w):
201	            numerator_h = h_in_offsets[:, None] + padding_h - kh * dilation_h
202	            numerator_w = w_in_offsets[None, :] + padding_w - kw * dilation_w
203
204	            valid_map_mask = (numerator_h % stride_h == 0) & (
205	                numerator_w % stride_w == 0
206	            )
207	            h_out = numerator_h // stride_h
208	            w_out = numerator_w // stride_w
209	            out_bounds_mask = (
210	                (h_out >= 0) & (h_out < out_h) & (w_out >= 0) & (w_out < out_w)
211	            )
212	            load_mask = valid_map_mask & out_bounds_mask
213
214	            safe_h_out = tl.where(load_mask, h_out, 0)
215	            safe_w_out = tl.where(load_mask, w_out, 0)
216	            out_offsets = safe_h_out * out_stride_h + safe_w_out
217
218	            indices_block = tl.load(
219	                indices_base_ptr + out_offsets, mask=load_mask, other=-1
220	            )
221	            match_mask = indices_block == current_input_flat_idx
222
223	            grad_block = tl.load(
224	                grad_output_base_ptr + out_offsets, mask=match_mask, other=0.0
225	            )
226	            grad_acc += grad_block
227
228	    grad_input_base_ptr = grad_input_ptr + nc_idx * in_h * in_w
229	    grad_input_offsets = h_in_offsets[:, None] * in_w + w_in_offsets[None, :]
230	    store_mask = (h_in_offsets[:, None] < in_h) & (w_in_offsets[None, :] < in_w)
231	    tl.store(grad_input_base_ptr + grad_input_offsets, grad_acc, mask=store_mask)
