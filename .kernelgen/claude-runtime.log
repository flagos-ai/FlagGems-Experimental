433	def max_pool3d_backward(
434	    grad_output: torch.Tensor,
435	    input: torch.Tensor,
436	    indices: torch.Tensor,
437	    kernel_size,
438	    stride,
439	    padding,
440	    dilation,
441	    ceil_mode,
442	):
443	    """Backward pass for 3-D max pooling."""
444	    logger.debug("GEMS MAX_POOL3D BACKWARD")
445	    grad_output = grad_output.contiguous()
446	    indices = indices.contiguous()
447
448	    params = _parse_pool3d_params(kernel_size, stride, padding, dilation)
449	    kd, kh, kw, sd, sh, sw, pd, ph, pw, dd, dh, dw = params
450
451	    in_n, in_c, in_d, in_h, in_w = input.shape
452	    out_d, out_h, out_w = (
453	        grad_output.shape[2],
454	        grad_output.shape[3],
455	        grad_output.shape[4],
456	    )
457
458	    grad_input = torch.zeros_like(input, dtype=torch.float32)
459
460	    if grad_input.numel() == 0:
461	        return grad_input.to(grad_output.dtype)
462
463	    out_spatial = out_h * out_w
464	    out_stride_nc = out_d * out_spatial
465	    out_stride_d = out_spatial
466	    out_stride_h = out_w
467	    out_stride_w = 1
468
469	    grid = lambda meta: (
470	        in_n * in_c,
471	        in_d
472	        * triton.cdiv(in_h, meta["BLOCK_IN_H"])
473	        * triton.cdiv(in_w, meta["BLOCK_IN_W"]),
474	    )
475
476	    max_pool3d_backward_kernel[grid](
477	        grad_output,
478	        indices,
479	        grad_input,
480	        in_d,
481	        in_h,
482	        in_w,
483	        out_d,
484	        out_h,
485	        out_w,
486	        out_stride_nc,
487	        out_stride_d,
488	        out_stride_h,
489	        out_stride_w,
490	        kd,
491	        kh,
492	        kw,
493	        sd,
494	        sh,
495	        sw,
496	        pd,
497	        ph,
498	        pw,
499	        dd,
500	        dh,
501	        dw,
502	    )
503
504	    return grad_input.to(grad_output.dtype)
