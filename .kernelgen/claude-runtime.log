166	    with torch_device_fn.device(inp.device):
167	        max_kernel[grid](inp, out_value, out_index, M, N, K)
168	    Max_out = namedtuple("max", ["values", "indices"])
169	    out = Max_out(values=out_value, indices=out_index)
170	    return out
