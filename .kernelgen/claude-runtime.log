99	def transform_exponential(u, lambd, eps):
100	    eps1 = -0.5 * eps
101	    is_min = u >= 1.0 + eps1
102	    log = tl.where(is_min, eps1, tl.math.log(u))
103	    v = -1.0 / lambd * log
104	    return v
