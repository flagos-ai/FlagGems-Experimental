66	@triton.jit
67	def max_pool2d_forward_kernel(
68	    input_ptr,
69	    output_ptr,
70	    indices_ptr,
71	    # Input tensor strides
72	    in_stride_n,
73	    in_stride_c,
74	    in_stride_h,
75	    in_stride_w,
76	    # Input/Output shapes
77	    in_c,
78	    in_h,
79	    in_w,
80	    out_h,
81	    out_w,
82	    # Pooling parameters
83	    kernel_h: tl.constexpr,
84	    kernel_w: tl.constexpr,
85	    stride_h: tl.constexpr,
86	    stride_w: tl.constexpr,
87	    padding_h: tl.constexpr,
88	    padding_w: tl.constexpr,
89	    dilation_h: tl.constexpr,
90	    dilation_w: tl.constexpr,
91	    # Meta-parameters for tiling
92	    BLOCK_H: tl.constexpr,
93	    BLOCK_W: tl.constexpr,
94	):
95	    pid_nc = tl.program_id(0)
96	    pid_hw = tl.program_id(1)
97	    num_w_blocks = tl.cdiv(out_w, BLOCK_W)
98	    h_block_idx = pid_hw // num_w_blocks
99	    w_block_idx = pid_hw % num_w_blocks
100	    n_idx = pid_nc // in_c
101	    c_idx = pid_nc % in_c
102
103	    h_out_offsets = h_block_idx * BLOCK_H + tl.arange(0, BLOCK_H)
104	    w_out_offsets = w_block_idx * BLOCK_W + tl.arange(0, BLOCK_W)
105
106	    dtype = input_ptr.type.element_ty
107	    min_val = get_dtype_min(dtype)
108	    max_val_acc = tl.full((BLOCK_H, BLOCK_W), min_val, dtype=dtype)
109	    max_idx_acc = tl.full((BLOCK_H, BLOCK_W), -1, dtype=tl.int64)
110
111	    input_base_ptr = input_ptr + n_idx * in_stride_n + c_idx * in_stride_c
112
113	    for kh in tl.static_range(0, kernel_h):
114	        for kw in tl.static_range(0, kernel_w):
115	            h_in = h_out_offsets[:, None] * stride_h - padding_h + kh * dilation_h
116	            w_in = w_out_offsets[None, :] * stride_w - padding_w + kw * dilation_w
117	            in_mask = (h_in >= 0) & (h_in < in_h) & (w_in >= 0) & (w_in < in_w)
118	            input_offset = h_in * in_stride_h + w_in * in_stride_w
119	            current_val = tl.load(
120	                input_base_ptr + input_offset, mask=in_mask, other=min_val
121	            )
122	            current_idx = h_in * in_w + w_in
123
124	            is_new_max = current_val > max_val_acc
125	            max_val_acc = tl.where(is_new_max, current_val, max_val_acc)
126	            max_idx_acc = tl.where(is_new_max & in_mask, current_idx, max_idx_acc)
127
128	    out_base_ptr = output_ptr + pid_nc * out_h * out_w
129	    indices_base_ptr = indices_ptr + pid_nc * out_h * out_w
130	    out_h_offsets = h_block_idx * BLOCK_H + tl.arange(0, BLOCK_H)
131	    out_w_offsets = w_block_idx * BLOCK_W + tl.arange(0, BLOCK_W)
132	    output_block_ptr = (
133	        out_base_ptr + out_h_offsets[:, None] * out_w + out_w_offsets[None, :]
134	    )
135	    indices_block_ptr = (
136	        indices_base_ptr + out_h_offsets[:, None] * out_w + out_w_offsets[None, :]
137	    )
138
139	    out_mask = (out_h_offsets[:, None] < out_h) & (out_w_offsets[None, :] < out_w)
140	    tl.store(output_block_ptr, max_val_acc, mask=out_mask)
141	    tl.store(indices_block_ptr, max_idx_acc, mask=out_mask)
