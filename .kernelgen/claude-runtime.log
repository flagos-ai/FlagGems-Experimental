32	@triton.jit(do_not_specialize=["philox_seed", "philox_offset", "N"])
33	def fused_exponential_kernel(
34	    out_ptr,
35	    N,
36	    is_double,
37	    lambd,
38	    eps,
39	    philox_seed,
40	    philox_offset,
41	    UNROLL,
42	    BLOCK: tl.constexpr,
43	):
44	    n_workers = tl.num_programs(0)
45	    pid = tl.program_id(0)
46	    n_tasks = tl.cdiv(N, BLOCK * UNROLL)
47	    tasks_per_worker = tl.cdiv(n_tasks, n_workers)
48
49	    for task_index in range(tasks_per_worker):
50	        task_id = pid + task_index * n_workers
51	        philox_seed_64 = philox_seed.to(tl.int64)
52	        philox_offset_64 = philox_offset.to(tl.int64)
53	        c0 = (philox_offset_64 & 0xFFFFFFFF).to(tl.uint32)
54	        c1 = ((philox_offset_64 >> 32) & 0xFFFFFFFF).to(tl.uint32)
55	        i4 = task_id * BLOCK + tl.arange(0, BLOCK)
56	        c0 += i4
57	        _O = c0 * 0
58	        r0, r1, r2, r3 = tl.philox(philox_seed_64, c0, c1, _O, _O)
59	        if is_double:
60	            d0 = uint_to_uniform_float(paste_u64(r0, r2))
61	            d1 = uint_to_uniform_float(paste_u64(r1, r3))
62	            y0 = transform_exponential(d0, lambd, eps)
63	            y1 = transform_exponential(d1, lambd, eps)
64	            # UNROLLL = 2
65	            start = task_id.to(tl.int64) * BLOCK * 2
66	            off_0 = start + tl.arange(0, BLOCK)
67	            off_1 = off_0 + BLOCK
68	            tl.store(out_ptr + off_0, y0, mask=off_0 < N, eviction_policy="evict_first")
69	            tl.store(out_ptr + off_1, y1, mask=off_1 < N, eviction_policy="evict_first")
70	        else:
71	            f0 = uint_to_uniform_float(r0)
72	            f1 = uint_to_uniform_float(r1)
73	            f2 = uint_to_uniform_float(r2)
74	            f3 = uint_to_uniform_float(r3)
75	            y0 = transform_exponential(f0, lambd, eps)
76	            y1 = transform_exponential(f1, lambd, eps)
77	            y2 = transform_exponential(f2, lambd, eps)
78	            y3 = transform_exponential(f3, lambd, eps)
79	            # UNROLLL = 4
80	            start = task_id.to(tl.int64) * BLOCK * 4
81	            off_0 = start + tl.arange(0, BLOCK)
82	            off_1 = off_0 + BLOCK
83	            off_2 = off_1 + BLOCK
84	            off_3 = off_2 + BLOCK
