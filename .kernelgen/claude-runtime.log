360	def max_pool3d_with_indices(
361	    input: torch.Tensor,
362	    kernel_size,
363	    stride=None,
364	    padding=0,
365	    dilation=1,
366	    ceil_mode=False,
367	):
368	    """Compute 3-D max pooling, returning (output, indices).
369
370	    Indices are flat offsets into the (D, H, W) spatial volume of the input.
371	    """
372	    logger.debug("GEMS MAX_POOL3D_WITH_INDICES")
373	    input = input.contiguous()
374
375	    params = _parse_pool3d_params(kernel_size, stride, padding, dilation)
376	    kd, kh, kw, sd, sh, sw, pd, ph, pw, dd, dh, dw = params
377
378	    in_n, in_c, in_d, in_h, in_w = input.shape
379	    out_d = pool3d_output_size(in_d, kd, sd, pd, dd, ceil_mode)
380	    out_h = pool3d_output_size(in_h, kh, sh, ph, dh, ceil_mode)
381	    out_w = pool3d_output_size(in_w, kw, sw, pw, dw, ceil_mode)
382
383	    output = torch.empty(
384	        (in_n, in_c, out_d, out_h, out_w), device=input.device, dtype=input.dtype
385	    )
386	    indices = torch.empty(
387	        (in_n, in_c, out_d, out_h, out_w), device=input.device, dtype=torch.int64
388	    )
389
390	    if output.numel() == 0:
391	        return output, indices
392
393	    grid = lambda meta: (
394	        in_n * in_c,
395	        out_d
396	        * triton.cdiv(out_h, meta["BLOCK_H"])
397	        * triton.cdiv(out_w, meta["BLOCK_W"]),
398	    )
399
400	    max_pool3d_forward_kernel[grid](
401	        input,
402	        output,
403	        indices,
404	        input.stride(0),
405	        input.stride(1),
406	        input.stride(2),
407	        input.stride(3),
408	        input.stride(4),
409	        in_c,
410	        in_d,
411	        in_h,
412	        in_w,
413	        out_d,
414	        out_h,
415	        out_w,
416	        kd,
417	        kh,
418	        kw,
419	        sd,
420	        sh,
421	        sw,
422	        pd,
423	        ph,
424	        pw,
425	        dd,
426	        dh,
427	        dw,
428	    )
429
430	    return output, indices
