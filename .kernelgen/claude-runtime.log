27	def max_pool2d_output_size(
28	    in_size: int,
29	    kernel_size: int,
30	    stride: int,
31	    padding: int,
32	    dilation: int,
33	    ceil_mode: bool = False,
34	) -> int:
35	    effective_kernel_size = (kernel_size - 1) * dilation + 1
36	    numerator = in_size + 2 * padding - effective_kernel_size
37	    if ceil_mode:
38	        output_size = (numerator + stride - 1) // stride + 1
39	        # PyTorch-compatible adjustment for ceil_mode
40	        if (output_size - 1) * stride >= in_size + padding:
41	            output_size -= 1
42	    else:
43	        output_size = numerator // stride + 1
44
45	    return output_size
