174	    out_w_offsets = w_block_idx * BLOCK_W + tl.arange(0, BLOCK_W)
175	    output_block_ptr = (
176	        out_base_ptr + out_h_offsets[:, None] * out_w + out_w_offsets[None, :]
177	    )
178	    indices_block_ptr = (
