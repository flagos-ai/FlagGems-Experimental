325	def _parse_pool3d_params(kernel_size, stride, padding, dilation):
326	    """Parse and validate 3-D pooling parameters.
327
328	    Each parameter can be an int (applied to all 3 spatial dims) or a
329	    3-element tuple/list (D, H, W).
330	    """
331
332	    def _parse_param(param, name, default=None):
333	        if param is None:
334	            return default
335	        if isinstance(param, int):
336	            return param, param, param
337	        if isinstance(param, (list, tuple)) and len(param) == 3:
338	            return tuple(param)
339	        raise ValueError(f"Invalid {name}: {param}")
340
341	    kd, kh, kw = _parse_param(kernel_size, "kernel_size")
342	    sd, sh, sw = _parse_param(stride, "stride", default=(kd, kh, kw))
343	    pd, ph, pw = _parse_param(padding, "padding", default=(0, 0, 0))
344	    dd, dh, dw = _parse_param(dilation, "dilation", default=(1, 1, 1))
345
346	    if sd <= 0 or sh <= 0 or sw <= 0:
347	        raise ValueError(f"stride must be positive, but got stride=({sd}, {sh}, {sw})")
348	    if pd < 0 or ph < 0 or pw < 0:
349	        raise ValueError(
350	            f"padding must be non-negative, but got padding=({pd}, {ph}, {pw})"
351	        )
352	    if dd <= 0 or dh <= 0 or dw <= 0:
353	        raise ValueError(
354	            f"dilation must be positive, but got dilation=({dd}, {dh}, {dw})"
355	        )
356
357	    return kd, kh, kw, sd, sh, sw, pd, ph, pw, dd, dh, dw
