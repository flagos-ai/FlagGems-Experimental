107	def exponential_(x, lambd: float = 1.0, *, gen=None):
108	    logger.debug("GEMS_ASCEND EXPONENTIAL_")
109	    dtype = x.dtype
110	    device = x.device
111	    inplace = x.is_contiguous()
112	    assert dtype in (torch.float16, torch.bfloat16, torch.float32, torch.float64)
113	    is_double = dtype in (torch.float64,)
114	    UNROLL = 2 if is_double else 4
115	    N = x.numel()
116
117	    def grid_fn(meta):
118	        grid = triton.cdiv(N, meta["BLOCK"] * UNROLL)
119	        grid = grid if grid < 240 else 240
120	        return (grid,)
121
122	    # (TODO) Using Triton autotuner makes kernel parameters opaque to the caller,
123	    # hence we cannot obtain the per thread offset as in Pytorch.
124	    increment = triton.cdiv(N, UNROLL)
125	    philox_seed, philox_offset = philox_backend_seed_offset(increment)
126	    eps = torch.finfo(dtype).eps
127	    x_ = x if inplace else torch.empty(x.size(), dtype=dtype, device=device)
128	    with torch_device_fn.device(device):
129	        fused_exponential_kernel[grid_fn](
130	            x_, N, is_double, lambd, eps, philox_seed, philox_offset, UNROLL
131	        )
132	    if not inplace:
133	        x.copy_(x_)
134	    return x
